# Copie para .env e ajuste. NUNCA commite o .env.
# docker compose le este arquivo automaticamente.

# --- PostgreSQL ---
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_PORT=5432

# --- Backend ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventhub
DB_USER=eventhub
DB_PASSWORD=eventhub
SERVER_PORT=8080

# --- Frontend ---
VITE_API_URL=http://localhost:8080

# --- Segurança ---
# Gere com: openssl rand -base64 48   (minimo 32 bytes)
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
