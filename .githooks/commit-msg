#!/bin/sh
#
# Valida a primeira linha do commit contra Conventional Commits.
# Instalar com: git config core.hooksPath .githooks
# Pular uma vez: git commit --no-verify

msg_file="$1"
first_line=$(head -n 1 "$msg_file" 2>/dev/null)

# Mensagem vazia (merge) ou comentario passa.
if [ -z "$first_line" ]; then
    exit 0
fi

case "$first_line" in
    \#*) exit 0 ;;
esac

case "$first_line" in
    Merge*|Revert*) exit 0 ;;
esac

pattern='^(feat|fix|refactor|test|docs|build|ci|chore|perf|style)(\([a-z0-9-]+\))?: .{1,72}$'

if echo "$first_line" | grep -Eq "$pattern"; then
    exit 0
fi

echo "" >&2
echo "  commit recusado: formato fora do padrao" >&2
echo "  recebido: $first_line" >&2
echo "" >&2
echo "  esperado: tipo(escopo): descricao" >&2
echo "  tipos: feat fix refactor test docs build ci chore perf style" >&2
echo "  regras completas: COMMITS.md" >&2
echo "" >&2
exit 1
